<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PaletteMaker.ViewModels"
        x:Class="PaletteMaker.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Palet Çıkarıcı"
        Width="940" Height="700" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20" RowSpacing="14">

    <!-- Başlık + RGB/CMYK geçişi -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock Text="Palet Çıkarıcı" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
        <RadioButton GroupName="mode" Content="RGB" IsChecked="{Binding IsRgb}" Classes="mode" />
        <RadioButton GroupName="mode" Content="CMYK" IsChecked="{Binding UseCmyk}" Classes="mode" />
      </StackPanel>
    </Grid>

    <!-- Görsel alanı -->
    <Border Grid.Row="1" x:Name="DropZone" Height="230" CornerRadius="12" BorderThickness="2"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            DragDrop.AllowDrop="True" Cursor="Hand" ClipToBounds="True"
            PointerPressed="OnDropZonePressed">
      <Grid>
        <Image Source="{Binding Preview}" Stretch="Uniform" Margin="8" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"
                    IsVisible="{Binding !HasImage}">
          <TextBlock Text="Görseli buraya sürükle ya da seçmek için tıkla" FontSize="16" HorizontalAlignment="Center" />
          <TextBlock Text="PNG, JPG, JPEG, WebP" Opacity="0.6" HorizontalAlignment="Center" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Bottom" />
      </Grid>
    </Border>

    <!-- Ayarlar -->
    <Grid Grid.Row="2" ColumnDefinitions="*,24,*" RowDefinitions="Auto">
      <StackPanel Spacing="2">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="En fazla renk" />
          <TextBlock Grid.Column="1" Text="{Binding MaxColorsText}" FontWeight="SemiBold" />
        </Grid>
        <Slider Minimum="2" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding MaxColors}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="2">
        <TextBlock Text="Ton birleştirme" />
        <Slider Minimum="0" Maximum="1" Value="{Binding MergeStrength}" />
        <Grid ColumnDefinitions="*,*">
          <TextBlock Text="Az" Opacity="0.6" FontSize="12" />
          <TextBlock Grid.Column="1" Text="Çok" Opacity="0.6" FontSize="12" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>
    </Grid>

    <!-- Palet -->
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding FileName}" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Content="Tümünü kopyala" IsEnabled="{Binding HasPalette}" Click="OnCopyAll" />
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Swatches}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SwatchViewModel">
              <Border Width="150" Margin="0,0,12,12" Padding="8" CornerRadius="12" Cursor="Hand"
                      Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                      Tapped="OnSwatchTapped">
                <StackPanel Spacing="6">
                  <Border Height="80" CornerRadius="8" Background="{Binding Brush}"
                          BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Hex}" FontWeight="SemiBold" FontFamily="monospace" />
                    <TextBlock Grid.Column="1" Text="{Binding ShareText}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding ValueText}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                             Tapped="OnValueTapped" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Alt not + geri bildirim -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
      <TextBlock Text="Karta tıkla: hex kopyalanır. Değer satırına tıkla: RGB/CMYK kopyalanır. CMYK, profilsiz yaklaşık değerdir."
                 FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" FontWeight="SemiBold" Margin="12,0,0,0" />
    </Grid>
  </Grid>

  <Window.Styles>
    <Style Selector="RadioButton.mode">
      <Setter Property="Padding" Value="14,6" />
    </Style>
  </Window.Styles>
</Window>
