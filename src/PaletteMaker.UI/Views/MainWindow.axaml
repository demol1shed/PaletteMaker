<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PaletteMaker.Views"
        xmlns:loc="using:PaletteMaker.Localization"
        x:Class="PaletteMaker.Views.MainWindow"
        Title="{loc:T AppTitle}"
        Width="940" Height="700" MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <!-- Masaüstü kabuğu. Tüm arayüz ShellView'dadır (sekmeler: Ayarlar, Görsel/MainView, Uyum); Android aynı görünümü penceresiz kullanır. -->
  <views:ShellView />
</Window>
