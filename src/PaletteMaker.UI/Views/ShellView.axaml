<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PaletteMaker.ViewModels"
             xmlns:views="using:PaletteMaker.Views"
             xmlns:loc="using:PaletteMaker.Localization"
             x:Class="PaletteMaker.Views.ShellView"
             x:DataType="vm:ShellViewModel">

  <!--
    Uygulama kabuğu: üç sekme görünümü (Ayarlar · Görsel · Uyum) tek Grid'de HEP CANLI durur, yalnızca IsVisible değişir
    (kaydırma/durum kaybolmaz, reklam görünümü her geçişte yeniden kurulmaz). Altta gezinme çubuğu. Alt sayfa ve bildirim
    burada, tüm sekmelerin ve çubuğun üstünde çizilir. Güvenli alan dolgusu (Padding) Avalonia tarafından bu görünüme
    uygulanır: kabuğa yerel Padding verme.
  -->
  <UserControl.Styles>
    <Style Selector="RadioButton.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="NavItem" MinHeight="64" Padding="8,8,8,6" Background="Transparent" BorderThickness="2"
                  BorderBrush="Transparent" CornerRadius="12">
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.nav Border.pill">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20,4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="RadioButton.nav:pointerover Border.pill">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>
    <Style Selector="RadioButton.nav:checked Border.pill">
      <Setter Property="Background" Value="{DynamicResource NavPill}" />
    </Style>
    <Style Selector="RadioButton.nav:checked TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.nav:focus-visible /template/ Border#NavItem">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="RadioButton.nav PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="RadioButton.nav TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="ShellRoot" RowDefinitions="*,Auto" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Grid x:Name="Pages">
      <views:SettingsView x:Name="SettingsPage" DataContext="{Binding Settings}" IsVisible="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).IsSettingsTab}" />
      <views:MainView x:Name="ImagePage" DataContext="{Binding Main}" IsVisible="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).IsImageTab}" />
      <views:HarmonyView x:Name="HarmonyPage" DataContext="{Binding Harmony}" IsVisible="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).IsHarmonyTab}" />
    </Grid>

    <Border x:Name="NavBar" Grid.Row="1" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            Background="{DynamicResource SheetBackground}"
            AutomationProperties.Name="{loc:T NavBarLabel}">
      <UniformGrid Rows="1" MaxWidth="560" HorizontalAlignment="Stretch">
        <RadioButton x:Name="NavSettings" Classes="nav" GroupName="MainNav" IsChecked="{Binding IsSettingsTab}"
                     AutomationProperties.Name="{loc:T NavSettings}">
          <StackPanel Spacing="2">
            <Border Classes="pill"><PathIcon Data="{StaticResource IconSettings}" /></Border>
            <TextBlock Text="{loc:T NavSettings}" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavImage" Classes="nav" GroupName="MainNav" IsChecked="{Binding IsImageTab}"
                     AutomationProperties.Name="{loc:T NavImage}">
          <StackPanel Spacing="2">
            <Border Classes="pill"><PathIcon Data="{StaticResource IconImage}" /></Border>
            <TextBlock Text="{loc:T NavImage}" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavHarmony" Classes="nav" GroupName="MainNav" IsChecked="{Binding IsHarmonyTab}"
                     AutomationProperties.Name="{loc:T NavHarmony}">
          <StackPanel Spacing="2">
            <Border Classes="pill"><PathIcon Data="{StaticResource IconPalette}" /></Border>
            <TextBlock Text="{loc:T NavHarmony}" />
          </StackPanel>
        </RadioButton>
      </UniformGrid>
    </Border>

    <!-- "Paylaş ve dışa aktar": nav çubuğunu da örter. DataContext = etkin palet ekranı. -->
    <views:ExportSheet x:Name="Sheet" Grid.RowSpan="2" DataContext="{Binding ActiveScreen}" />

    <!-- Kopyalama bildirimi: sekme içeriğinin üstünde, çubuğun hemen üstünde alt ortada -->
    <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,24"
            Padding="16,10" CornerRadius="20" Background="#E6202020" BorderBrush="#40FFFFFF" BorderThickness="1"
            IsHitTestVisible="False"
            IsVisible="{Binding ActiveScreen.ToastMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ActiveScreen.ToastMessage}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                 AutomationProperties.LiveSetting="Polite" />
    </Border>
  </Grid>
</UserControl>
